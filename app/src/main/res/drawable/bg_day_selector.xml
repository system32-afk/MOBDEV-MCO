<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active Orange Circle when selected -->
    <item android:drawable="@drawable/shape_orange_circle" android:state_selected="true" />
    <!-- Inactive White Circle with border when unselected -->
    <item android:state_selected="false">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#EAEAEA" />
        </shape>
    </item>
</selector>