<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14163A"
    tools:context=".DailyMath">

    <ImageButton
        android:id="@+id/backBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_dark_circle"
        app:layout_constraintBottom_toTopOf="@+id/challengeNumTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.043"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_chevron_left" />

    <LinearLayout
        android:id="@+id/streakIv"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_streak_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.97"
        app:layout_constraintStart_toEndOf="@+id/backBtn"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/flameIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_flame" />

        <TextView
            android:id="@+id/streakNumTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5-day streak"
            android:textColor="#C4C7EA"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/challengeNumTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/bricolage_grotesque_semibold"
        android:text="MIND ~ CHALLENGE 1 OF 3"
        android:textColor="#FF7A2F"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/titleTv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.067"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/titleTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="92dp"
        android:fontFamily="@font/bricolage_grotesque_bold"
        android:text="Daily Math"
        android:textColor="#F4F2FF"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.055"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/probNumTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/bricolage_grotesque_medium"
        android:text="Problem 1 of 3 ~ warm up your brain."
        android:textColor="#C4C7EA"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.089"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTv" />

    <TextView
        android:id="@+id/answerTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Your answer"
        android:textColor="#C4C7EA"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.061"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardProblem" />

    <EditText
        android:id="@+id/answerField"
        android:layout_width="374dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_dark_input_outline"
        android:ems="10"
        android:fontFamily="@font/bricolage_grotesque_bold"
        android:hint="Type the result"
        android:inputType="numberDecimal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="#C4C7EA"
        android:textColorHint="#C4C7EA"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/answerTv" />

    <Button
        android:id="@+id/checkAnswerBtn"
        android:layout_width="353dp"
        android:layout_height="50dp"
        android:layout_marginBottom="52dp"
        android:fontFamily="@font/dm_sans_bold"
        android:text="Check answer"
        android:textColor="#14163A"
        android:textColorLink="#FFFFFF"
        android:textSize="16sp"
        app:backgroundTint="#FF7A2F"
        app:cornerRadius="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardProblem"
        android:layout_width="374dp"
        android:layout_height="180dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#23265A"
        app:cardCornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/problemTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/bricolage_grotesque_extrabold"
                android:gravity="center"
                android:text="47 + 38 × 2"
                android:textColor="#F4F2FF"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/equalsTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bricolage_grotesque_extrabold"
                android:gravity="center"
                android:text="= ?"
                android:textColor="#FF7A2F"
                android:textSize="26sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/progressContainer"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/probNumTv">

        <View
            android:id="@+id/progressSegment1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_progress_segment"
            android:backgroundTint="#FF7A00" />

        <View
            android:id="@+id/progressSegment2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_progress_segment"
            android:backgroundTint="#2A2F5E" />

        <View
            android:id="@+id/progressSegment3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_progress_segment"
            android:backgroundTint="#2A2F5E" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>