<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp"
    tools:context=".AlarmRingingActivity">

    <!-- Top row: status pill and ringtone label -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_pill_raised"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Ringing"
            android:textColor="@color/main_text_dark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvRingtone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio · Daybreak"
            android:textColor="@color/muted_dark"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRiseShine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="Rise &amp; shine"
        android:textColor="@color/muted_dark"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvAlarmTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="06:30"
        android:textColor="@color/main_text_dark"
        android:textSize="64sp"
        android:textStyle="bold" />

    <!-- Decorative circle: outer raised ring, inner orange disc -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1">

        <View
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:background="@drawable/shape_circle_raised" />

        <View
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_gravity="center"
            android:background="@drawable/shape_circle_orange" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvStreak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="5-day streak · 3 challenges waiting"
        android:textColor="@color/muted_dark"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnStopAlarm"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/shape_pill_white"
        android:stateListAnimator="@null"
        android:text="Picture an object to stop the alarm!"
        android:textAllCaps="false"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
