<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14163A"
    android:fillViewport="true"
    tools:context=".activity_daily_walk">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹  Back"
            android:textColor="#F4F2FF"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="🚶 Daily Walk"
            android:textColor="#F4F2FF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Keep moving, one step at a time."
            android:textColor="#C4C7EA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:gravity="center"
            android:text="3,240"
            android:textColor="#FF7A2F"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="of 6,000 steps"
            android:textColor="#F4F2FF"
            android:textSize="18sp" />

        <ProgressBar
            android:id="@+id/walkProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="30dp"
            android:max="6000"
            android:progress="3240"
            android:progressTint="#FF7A2F"
            android:progressBackgroundTint="#2A2D5E" />

        <TextView
            android:id="@+id/tvRemaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="2,760 steps remaining"
            android:textColor="#C4C7EA"
            android:textSize="15sp" />

        <!-- progress panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="#23265A"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Today's progress"
                android:textColor="#F4F2FF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="✓  1,000 steps completed"
                android:textColor="#FF7A2F"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="✓  3,000 steps completed"
                android:textColor="#FF7A2F"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="○  6,000 steps — Daily goal"
                android:textColor="#C4C7EA"
                android:textSize="15sp" />

        </LinearLayout>
        <!-- information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Every step counts!"
            android:textColor="#F4F2FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Walking is a simple way to stay active. Complete your daily step goal to finish today's Body challenge."
            android:textColor="#C4C7EA"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp" />
        <!-- STATUS -->
        <TextView
            android:id="@+id/tvWalkStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="Challenge in progress"
            android:textColor="#FF7A2F"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
